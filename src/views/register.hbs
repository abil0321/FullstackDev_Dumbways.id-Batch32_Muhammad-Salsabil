<html lang="en">

  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Create an Account</title>
    <!-- Bootstrap CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/css/register.css" />
  </head>

  <body>
    <div
      class="container-fluid p-0 d-flex flex-column flex-md-row"
      style="height: 100vh;"
    >
      <div class="left-panel col-md-6 d-none d-md-block"></div>
      <div class="right-panel col-12 col-md-6">
        <div class="gray-circle" aria-hidden="true"></div>

        <h2 class="mb-1">Create an account</h2>
        {{#if errorMessage}}
          <div class="alert alert-danger" role="alert">
            {{errorMessage}}
          </div>
        {{/if}}
        {{#if error}}
          <div class="alert alert-danger" role="alert">
            {{error}}
          </div>
        {{/if}}

        <p style="font-size: 0.9rem; margin-bottom: 1.5rem;">
          Already have an account?
          <a href="/login" tabindex="0">Log in</a>
        </p>

        <form action="/register" method="POST" id="registerForm" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="name" class="form-label small">Your Name</label>
            <input
              type="text"
              class="form-control"
              id="name"
              name="name"
              placeholder="Enter your user name"
              required
            />
            <div class="invalid-feedback">
              Please enter your user name.
            </div>
          </div>
          <div class="mb-3">
            <label for="email" class="form-label small">Email address</label>
            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              placeholder="Enter your email"
              required
            />
            <div class="invalid-feedback">
              Please enter a valid email address.
            </div>
          </div>

          <div class="mb-3">
            <label
              for="exampleInputPassword1"
              class="form-label"
            >Password</label>
            <input
              type="password"
              class="form-control"
              id="exampleInputPassword1"
              name="password"
              placeholder="Enter your password"
              required
            />
          </div>

          <div class="mb-3">
            <label for="profile_img" class="form-label fw-semibold">Upload
              Image</label>
            <input
              class="form-control"
              type="file"
              id="profile_img"
              name="upload_image"
            />
          </div>

          <p style="font-size: 0.8rem; margin-bottom: 1rem;">
            By creating an account, you agree to our
            <a href="#" tabindex="0">Terms of use</a>
            and
            <a href="#" tabindex="0">Privacy Policy</a>.
          </p>

          <button type="submit" id="submitBtn" class="btn btn-primary">Create an
            account</button>
        </form>

        <div class="small-login-link">
          Already have an account?
          <a href="/login" tabindex="0">Log in</a>
        </div>
      </div>
    </div>

    <!-- Bootstrap JS Bundle with Popper -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
    ></script>
  </body>

</html>