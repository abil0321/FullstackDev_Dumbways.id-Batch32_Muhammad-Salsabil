        <!-- Main Content Container -->
        <main class="container my-4">
          <!-- Title & Subtitle -->
          <div class="row align-items-center mb-5" id="home">
            <section class="col-lg-12 col-md-12">
              <h1 class="fw-bold"><span class="text-purple">/</span>project</h1>
              <p class="fs-5 ms-1">List Of My Projects</p>
            </section>
          </div>
          <!-- Complete Apps Projects -->
          <section id="complete-apps" class="mb-5">
            <h3 class="text-purple mb-3">#complete-apps</h3>
            <div class="row g-4">
              <!-- Project 1 -->
              {{#each portfolios}}
              <div class="col-md-4">
                <div class="project-card p-3 h-100 d-flex flex-column justify-content-between">
                  <img src="/assets/img/{{this.upload_image}}" alt="{{this.name}}" class="placeholder-img mb-3"
                    onerror="this.onerror=null;this.src='https://storage.googleapis.com/workspace-0f70711f-8b4e-4d94-86f1-2a93ccde5887/image/5fb493cc-8faa-4a94-85a4-ea55c3acc7c4.png';" />
                  <small class="text-muted-custom d-flex align-items-center">
                    {{#if this.nodejs}}NodeJs {{/if}}
                    {{#if this.nextjs}}NextJs </i>{{/if}}
                    {{#if this.reactjs}}ReactJs {{/if}}
                    {{#if this.typescript}}TypeScript {{/if}}
                    {{#if this.laravel}}Laravel {{/if}}
                  </small>
                  <h5 class="fw-bold mt-2">{{this.name}}</h5>
                  <p class="mb-3" style="font-size: 0.85rem">
                    {{this.description}}
                  </p>
                  <div class="d-flex gap-2">
                    <a href="{{this.url_demo}}" class="project-btn" title="Live Demo" target="_blank"><i class="bi bi-box-arrow-up-right"></i>
                      Live</a>
                    <a href="{{this.url_github}}" class="project-btn" title="Github" target="_blank"><i class="bi bi-folder2-open"></i> Github  </a>
