<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Profile Card with Bootstrap 5</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

  <link rel="stylesheet" href="/assets/css/index.css" />
</head>

<body>
  <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">
      <a class="navbar-brand d-flex align-items-center" href="/">
        <img src="/assets/img/logo_dumbwaysid.png" alt="Logo" width="64" height="44"
          class="d-inline-block align-text-top me-3" />
      </a>
      <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu"
        aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navMenu">
        <ul class="navbar-nav align-items-center gap-lg-3">
          <li class="nav-item">
            <a class="nav-link active fw-bold" aria-current="page" href="/">Home</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/">My Project</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/about">About Me</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" >{{ dataUser.email }}</a>
          </li>
        </ul>

        <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center gap-2">
          {{!-- <li class="nav-item">
            <a class="btn btn-primary" href="/login">Login</a>
          </li>
          <li class="nav-item">
            <a class="btn btn-primary" href="/register">Register</a>
          </li> --}}
          <li class="nav-item">
            <a class="btn btn-success" href="/contact">Contact Me!</a>
          </li>
          {{#if dataUser}}
          <li class="nav-item">
            <a class="btn btn-danger" href="/logout">Logout</a>
          </li>
          {{/if}}
        </ul>
      </div>
    </div>
  </nav>

  <section class="container py-5 my-5">
    <div class="row rounded-3 shadow card-profile p-5">
      <div class="col-md-12">
        <!-- Add Project Form -->
        <section class="mb-5">
          <h3 class="text-center fw-bold mb-4" style="letter-spacing: 0.06em">
            ADD {{ dataUser.name }} PROJECT
          </h3>

          <form id="form" action="/project" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label for="projectName" class="form-label fw-semibold">Project Name</label>
              <input type="text" class="form-control" id="name" name="name" placeholder="" />
            </div>

            <div class="row mb-3">
              <div class="col-md-6 mb-3 mb-md-0">
                <label for="start_date" class="form-label fw-semibold">Start Date</label>
                <input type="date" class="form-control" id="start_date" name="start_date" />
              </div>
              <div class="col-md-6">
                <label for="end_date" class="form-label fw-semibold">End Date</label>
                <input type="date" class="form-control" id="end_date" name="end_date" />
              </div>
            </div>

            <div class="mb-3">
              <label for="description" class="form-label fw-semibold">Description</label>
              <textarea class="form-control" id="description" rows="3" name="description"></textarea>
            </div>

            <fieldset class="mb-3 row">
              <legend class="col-form-label fw-semibold mb-2">
                Technologies
              </legend>
              <div class="col-md-4 col-sm-6 d-grid gap-3">
                <div class="form-check form-check-inline d-flex align-items-center gap-2">
                  <input class="form-check-input" type="checkbox" id="nodejs" value="Node Js" name="nodejs" />
                  <label class="form-check-label" for="nodejs">Node Js</label>
                </div>
                <div class="form-check form-check-inline d-flex align-items-center gap-2">
                  <input class="form-check-input" type="checkbox" id="nextjs" value="Next Js" name="nextjs" />
                  <label class="form-check-label" for="nextjs">Next Js</label>
                </div>
              </div>

              <div class="col-md-4 col-sm-6 d-grid gap-3">
                <div class="form-check form-check-inline d-flex align-items-center gap-2">
                  <input class="form-check-input" type="checkbox" id="reactjs" value="React Js" name="reactjs" />
                  <label class="form-check-label" for="reactjs">React Js</label>
                </div>
                <div class="form-check form-check-inline d-flex align-items-center gap-2">
                  <input class="form-check-input" type="checkbox" id="typescript" value="TypeScript"
                    name="typescript" />
                  <label class="form-check-label" for="typescript">TypeScript</label>
                </div>
              </div>
            </fieldset>

            <div class="mb-4">
              <label for="upload_image" class="form-label fw-semibold">Upload Image</label>
              <input class="form-control" type="file" id="upload_image" name="upload_image" />
            </div>

            <div class="text-end">
              <button id="submitBtn" type="submit">submit</button>
            </div>
          </form>
        </section>

        <!-- Projects List Section -->
        <section class="bg-white rounded-3 shadow p-5">
          <h3 class="text-center fw-bold mb-5" style="letter-spacing: 0.06em">
            MY PROJECT
          </h3>
          <div class="cards-container row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
            {{#each projects}}
            <div class="col">
              <div class="card shadow-sm h-100">
                <a href="/project/{{this.id}}">
                  <img src="/assets/img/{{this.upload_image}}" class="card-img-top" alt="{{this.name}}">
                </a>
                <div class="card-body d-flex flex-column">
                  <h5 class="card-title mb-1"><a href="/project/{{this.id}}" class="text-decoration-none text-dark">{{this.name}}</a></h5>
                  <small class="text-muted">Durasi: {{this.duration}}</small>
                  <p class="card-text mt-2 flex-grow-1">{{this.description}}</p>
                  <div class="tech-icons mb-3 d-flex align-items-center gap-2">
                    {{#if this.nodejs}}NodeJs<i class="fab fa-node-js fs-4 me-2"></i>{{/if}}
                    {{#if this.nextjs}}NextJs</i>{{/if}}
                    {{#if this.reactjs}}ReactJs<i class="fab fa-react fs-4 me-2"></i>{{/if}}
                    {{#if this.typescript}}TypeScript<i class="fab fa-js-square fs-4 me-2"></i>{{/if}}
                  </div>
                  <div class="d-flex justify-content-between align-items-center">
                    <div class="btn-group w-100 gap-1">
                      <a href="/project/{{this.id}}/edit" class="btn btn-sm btn-edit">Edit</a>
                      <form action="/project/{{this.id}}/delete" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-delete" onclick="return confirm('Are you sure you want to delete this project?');">Delete</button>
                      </form>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </section>
      </div>
    </div>

    <div class="p-4 p-lg-5"></div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
  <script src="assets/scripts/index.js"></script>

  <img" src="" alt="">
</body>

</html>